# --- Firebase Web SDK (client) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_IMPORT_API_URL=http://localhost:8080

# --- Gemini (Auto-rotating across multiple keys) ---
# Default model: gemini-3.5-flash-lite (can be overridden to gemini-2.5-flash etc.)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Or comma-separated list of keys:
# GEMINI_API_KEYS=key1,key2,key3

# --- Google OAuth (for Forms API) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/google/callback

# --- Firebase Admin (service account) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Per-user AI Rate Limits (optional, defaults shown) ---
AI_RATE_HOURLY=30   # max AI requests per user per hour (default: 30)
AI_RATE_PER_MIN=5   # burst limit per user per minute (default: 5)

